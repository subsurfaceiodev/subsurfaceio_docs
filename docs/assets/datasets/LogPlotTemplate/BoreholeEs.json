{
  "figure": {
    "title": "REGISTRO DE PERFORACI\u00d3N {test_id}",
    "y_values_per_page": 10
  },
  "column_headers": {
    "size": "10%"
  },
  "header": {
    "nrows": 8
  },
  "columns": [
    {
      "title": {
        "title": "PROF. (m)",
        "rotation": "vertical"
      },
      "width_ratio": 0.15,
      "model": {
        "column_type": "axis"
      }
    },
    {
      "title": {
        "title": "LOG\nGR\u00c1FICO",
        "rotation": "vertical"
      },
      "width_ratio": 0.15,
      "model": {
        "column_type": "graphic",
        "data_source": "strata",
        "y_top_field": "depth_top",
        "y_bottom_field": "depth",
        "hatch_field": "hatch"
      }
    },
    {
      "title": {
        "title": "COLOR",
        "rotation": "vertical"
      },
      "width_ratio": 0.1,
      "model": {
        "column_type": "graphic",
        "data_source": "strata",
        "y_top_field": "depth_top",
        "y_bottom_field": "depth",
        "color_field": "color"
      }
    },
    {
      "title": {
        "title": "DESCRIPCI\u00d3N DEL MATERIAL"
      },
      "width_ratio": 1.5,
      "model": {
        "column_type": "text",
        "data_source": "strata",
        "text_field": "{depth_top:.2f}m\n{description}",
        "y_top_field": "depth_top",
        "y_bottom_field": "depth",
        "parameters": {}
      }
    },
    {
      "title": {
        "title": "MUESTREADOR",
        "rotation": "vertical"
      },
      "width_ratio": 0.075,
      "model": {
        "column_type": "graphic",
        "data_source": "samples",
        "y_top_field": "depth_top",
        "y_bottom_field": "depth",
        "hatch_field": "sampler_type"
      }
    },
    {
      "title": {
        "title": "MUESTREADOR\nN\u00daMERO",
        "rotation": "vertical"
      },
      "width_ratio": 0.15,
      "model": {
        "column_type": "text",
        "data_source": "samples",
        "text_field": "{sampler_type}\n{sample}",
        "y_top_field": "depth_top",
        "y_bottom_field": "depth",
        "parameters": {
          "horizontal_alignment": "center"
        }
